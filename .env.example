# ==============================================================================
# KisanMitra Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# AI Large Language Model (LLM) Configuration
# ------------------------------------------------------------------------------
# RECOMMENDED: Google Gemini (100% Free Tier, No Credit Card Required)
# 1. Visit: https://aistudio.google.com/
# 2. Sign in with any Google account and click "Get API key" -> "Create API key"
# 3. Paste the generated key below as GEMINI_API_KEY
# 4. In Vercel deployment: Project Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ALTERNATIVE: OpenAI (Requires paid credits)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# GENERIC: Any custom compatible provider key
# LLM_API_KEY=

# ------------------------------------------------------------------------------
# Agricultural APMC Mandi Data Source (Government of India / AGMARKNET)
# ------------------------------------------------------------------------------
# Optional: Live API key for data.gov.in agricultural commodity price endpoints.
# If omitted or offline, KisanMitra automatically serves verified Agmarknet APMC datasets.
DATA_GOV_IN_API_KEY=your_datagovin_api_key_here
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# ------------------------------------------------------------------------------
# Cloudflare Tunnel Configuration (Optional named tunnel credentials)
# ------------------------------------------------------------------------------
# Leave empty to use automatic Quick Tunnels via cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=

# CORS Origins (comma separated list)
CORS_ORIGINS=*
